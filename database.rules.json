{
  "rules": {
    "users": {
      "$uid": {
        ".read": true,
        ".write": "$uid === auth.uid"
      }
    },
    "stripe_customers": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": false
      }
    },
    "friends": {
      "$uid": {
        ".read": "$uid === auth.uid",
        "$friendId": {
          ".write": "$uid === auth.uid || $friendId === auth.uid"
        }
      }
    },
    "friend_requests": {
      "$uid": {
        ".read": "$uid === auth.uid",
        "$fromUid": {
          ".write": "$fromUid === auth.uid || $uid === auth.uid"
        }
      }
    },
    "groups": {
      "$groupId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "user_groups": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid || auth != null"
      }
    },
    "group_invites": {
      "$uid": {
        ".read": "$uid === auth.uid",
        "$groupId": {
          ".write": "auth != null"
        }
      }
    },
    "group_activity": {
      "$groupId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "races": {
      ".read": "auth != null",
      "$raceId": {
        ".write": "auth != null"
      }
    },
    "user_races": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid || auth != null"
      }
    },
    "race_invites": {
      "$uid": {
        ".read": "$uid === auth.uid",
        "$raceId": {
          ".write": "auth != null"
        }
      }
    },
    "user_progress": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid"
      }
    },
    "leaderboards": {
      ".read": "auth != null",
      "weekly": {
        "$weekKey": {
          "$uid": {
            ".write": "$uid === auth.uid"
          }
        }
      },
      "monthly": {
        "$monthKey": {
          "$uid": {
            ".write": "$uid === auth.uid"
          }
        }
      },
      "alltime": {
        "$uid": {
          ".write": "$uid === auth.uid"
        }
      },
      "routes": {
        "$routeKey": {
          "$uid": {
            ".write": "$uid === auth.uid"
          }
        }
      }
    }
  }
}
