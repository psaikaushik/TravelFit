{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && !root.child('account_deletions').child($uid).exists()",
        ".write": "auth != null && auth.uid === $uid && !root.child('account_deletions').child($uid).exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'email', 'createdTime'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 320"
        },
        "createdTime": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
